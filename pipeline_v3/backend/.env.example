OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

APP_NAME=persona_tamil_pipeline
PIPELINE_VERSION=v5_advanced
DEBUG=false
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_DOCS_ENABLED=true

# Set this in production. The mobile app sends this as X-API-Key.
API_KEY=replace_this_with_a_long_random_secret

# Comma-separated list. Do not use * in production.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

MAX_MESSAGE_CHARS=4000
MAX_AUDIO_UPLOAD_BYTES=12582912
APP_STATE_MAX_BYTES=262144

DEFAULT_USER_ID=demo_user